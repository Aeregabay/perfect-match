# Public values only. Never put the service_role key in the app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public website hosting the privacy policy, terms and the account-deletion page (required by Google Play).
VITE_PUBLIC_SITE_URL=https://your-domain.example
# Cloudflare Turnstile site key (bot protection for sign-up/sign-in). Leave empty to disable.
VITE_TURNSTILE_SITE_KEY=
